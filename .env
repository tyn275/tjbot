#ID của thiết bị
BOT_ID=tjbot1

# Thông tin kết nối MQTT Broker
MQTT_BROKER=mqtt.toolhub.app
MQTT_PORT=1883
MQTT_USER=tjbot1
MQTT_PASSWORD=sinno

# Cấu hình Topic và Client ID
MQTT_CLIENT_ID=raspberry-pi-tjbot1
MQTT_TOPIC_SUB=commands  # Đầy đủ sẽ là {BOT_ID}/commands
MQTT_TOPIC_PUB=status    # Đầy đủ sẽ là {BOT_ID}/status