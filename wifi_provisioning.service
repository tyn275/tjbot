[Unit]
Description=Dịch vụ Cấu hình mạng Bluetooth UART khép kín cho TJBot
After=bluetooth.target

[Service]
Type=simple
WorkingDirectory=/home/pi/tjbot_conn

# --- KHỐI LỆNH 1: Ủy quyền toàn bộ cấu hình phần cứng cho file Script .sh của bạn ---
ExecStartPre=/home/pi/tjbot_conn/setting_bluetooth.sh

# --- KHỐI LỆNH 2: Khởi chạy file Python quản lý ---
ExecStart=/home/pi/tjbot_conn/venv/bin/python3 wifi_provisioning.py

# --- KHỐI LỆNH 3: CẤU HÌNH CHỐNG TREO KHI STOP (BỔ SUNG MỚI) ---
# Ép diệt sạch toàn bộ các tiến trình con (bao gồm cả lệnh rfcomm listen trong Python)
KillMode=control-group
# Nếu sau 3 giây không chịu tự tắt, Systemd sẽ dùng vũ lực ép chết ngay lập tức
TimeoutStopSec=3

Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target